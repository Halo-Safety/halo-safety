# On Vercel leave this empty to run the clearly labelled browser-local demo.
# Later set it to the public HTTPS URL of a persistent authenticated Flask API.
VITE_API_BASE_URL=
# Set true to use simulated sample events locally without running Flask.
VITE_DEMO_MODE=false
# Only applies in connected API mode; do not enable against a public unprotected API.
VITE_ENABLE_DEMO=false
